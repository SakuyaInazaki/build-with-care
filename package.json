    "version": "0.1.3-alpha.1",
    "status": "optional-adapter-not-installed"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
