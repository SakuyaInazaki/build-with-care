{
  "name": "decision-stream-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend start",
    "typecheck": "npm --prefix decision-desk run check && npm --prefix frontend exec tsc -- --noEmit -p frontend/tsconfig.json",
    "test": "npm --prefix decision-desk test && npm --prefix frontend test",
    "test:reference": "vitest run",
    "typecheck:reference": "tsc --noEmit"
  },
  "deepseekHarness": {
    "version": "0.1.2-rc.1",
    "status": "active-via-decision-desk"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
