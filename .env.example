# 决策流工作台 · LLM 配置示例
# 用法：cp .env.example .env 后填入真实密钥（.env 已在 .gitignore 里，绝不提交）。
# 进程环境变量优先于 .env；.env 只补空缺。没有配置任何模型时，一切功能仍可用（规则判官 + 脚本 demo）。
#
# 三个角色：
#   AGENT     干活模型（驱动真实 tool-calling loop，典型是 DeepSeek）
#   JUDGE     独立判官（给每一步判红/蓝/灰）——必须与 AGENT "异源"（不同模型家族）
#   RECORDER  记录员/对账员，缺省逐字段沿用 JUDGE；只想换模型时单独覆盖 RECORDER_MODEL 即可
#
# 每个角色的变量（把 <ROLE> 换成 AGENT / JUDGE / RECORDER）：
#   DECISION_STREAM_<ROLE>_PROVIDER    openai | anthropic
#       openai    = 任何 OpenAI 兼容的 chat/completions：DeepSeek、GPT、Gemini/国产模型网关、LiteLLM、OneAPI……
#       anthropic = Anthropic Messages API（/v1/messages）：Claude 直连或兼容网关
#   DECISION_STREAM_<ROLE>_BASE_URL    接口根地址。openai 一般带 /v1（缺省 https://api.openai.com/v1）；
#                                      anthropic 缺省 https://api.anthropic.com（/v1/messages 自动补）
#   DECISION_STREAM_<ROLE>_API_KEY     密钥（必填；永远不会被打印或写进日志/接口）
#   DECISION_STREAM_<ROLE>_MODEL       模型名（必填）
#   DECISION_STREAM_<ROLE>_TIMEOUT_MS  单次请求超时，缺省 60000
#
# 赛事提供的免费模型（Claude / GPT / Gemini / 国内模型）通常经由一个 OpenAI 兼容网关暴露：
# 把 PROVIDER 设为 openai，BASE_URL 指向网关（含 /v1），MODEL 填网关里的模型名即可。

# ---------- 干活 agent：DeepSeek（OpenAI 兼容） ----------
DECISION_STREAM_AGENT_PROVIDER=openai
DECISION_STREAM_AGENT_BASE_URL=https://api.deepseek.com/v1
DECISION_STREAM_AGENT_API_KEY=sk-your-deepseek-key
DECISION_STREAM_AGENT_MODEL=deepseek-chat

# ---------- 判官：Claude 直连（Anthropic Messages API） ----------
DECISION_STREAM_JUDGE_PROVIDER=anthropic
DECISION_STREAM_JUDGE_BASE_URL=https://api.anthropic.com
DECISION_STREAM_JUDGE_API_KEY=sk-ant-your-key
DECISION_STREAM_JUDGE_MODEL=claude-opus-5

# ---------- 判官备选：走赛事 OpenAI 兼容网关（Claude / GPT / Gemini 都是这种写法） ----------
# DECISION_STREAM_JUDGE_PROVIDER=openai
# DECISION_STREAM_JUDGE_BASE_URL=https://gateway.example.com/v1
# DECISION_STREAM_JUDGE_API_KEY=your-gateway-key
# DECISION_STREAM_JUDGE_MODEL=gpt-5

# ---------- 记录员：缺省沿用 JUDGE；只换模型的写法 ----------
# DECISION_STREAM_RECORDER_MODEL=claude-sonnet-5
# 或者完全独立配置：
# DECISION_STREAM_RECORDER_PROVIDER=openai
# DECISION_STREAM_RECORDER_BASE_URL=https://gateway.example.com/v1
# DECISION_STREAM_RECORDER_API_KEY=your-gateway-key
# DECISION_STREAM_RECORDER_MODEL=gemini-2.5-pro
