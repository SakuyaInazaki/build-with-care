# DeepSeek: one key for both roles. Model defaults to deepseek-v4-flash.
DEEPSEEK_API_KEY=

# Optional per-role overrides. Custom endpoints use their own keys.
# Both endpoints must support OpenAI-compatible Chat Completions.
WORKER_BASE_URL=
WORKER_MODEL=
WORKER_FAMILY=
WORKER_API_KEY=

# Reviewer requests use independent context; the provider may be the same.
REVIEWER_BASE_URL=
REVIEWER_MODEL=
REVIEWER_FAMILY=
REVIEWER_API_KEY=

PORT=4317
DATA_DIR=.data/runs
