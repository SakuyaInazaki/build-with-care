# 复制成 .env.deploy 后填写，docker compose 会自动读取同目录的 .env；
# 部署脚本会把本文件链接为 .env。

# 评委实际访问的地址（host[:port]，不带 http://）。必须和浏览器地址栏完全一致，
# 否则后端会以「只允许本地访问」403 拒绝。
PUBLIC_HOST=101.201.125.231:8080

# 宿主机对外端口。大陆服务器未备案域名时避开 80/443，用 8080 这类端口更稳。
PUBLIC_PORT=8080

# 1 = 公开演示站护栏（推荐）；0 = 完整能力，仅限内网/本机使用。
PUBLIC_DEMO=1

# 预置展示记录的 run ID（逗号分隔），永不清理且只读。
PUBLIC_DEMO_PINNED=1844987c-8a92-4f2e-b3c8-abd32910be03

# 国内服务器用 npmmirror 明显更快；海外机器可改成 https://registry.npmjs.org
NPM_REGISTRY=https://registry.npmmirror.com
